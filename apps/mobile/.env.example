# Mobile connects directly to the independently deployed API. Production requires HTTPS.
# Local API defaults to port 3001; port 3000 belongs to Web and requires its proxy to run.
# iOS simulator: http://127.0.0.1:3001
# Android emulator: http://10.0.2.2:3001
# Physical phone: http://<computer-LAN-IP>:3001, with API_HOST=0.0.0.0 on the API.
# Restart Metro after changing this value; no development-build rebuild is needed.
EXPO_PUBLIC_API_URL=https://api.example.com

# Public UI prototype only. These are bundled demo values, not server credentials.
EXPO_PUBLIC_DEMO_EMAIL=syf@outlook.com

EXPO_PUBLIC_DEMO_PASSWORD=test001
