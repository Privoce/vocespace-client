{
  "expo": {
    "name": "VoceSpace",
    "slug": "vocespace-mobile",
    "scheme": "vocespace",
    "version": "1.0.0",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.privoce.vocespace",
      "appleTeamId": "355Y8J4TGX",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.vocespace.mobile.dev",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "zh-Hans", "ru"],
            "android": ["en", "zh", "ru"]
          }
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "enableScreenShareService": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "\u5141\u8bb8 VoceSpace \u5728\u4f60\u5f00\u542f\u6444\u50cf\u5934\u65f6\u4f20\u8f93\u89c6\u9891\u3002",
          "microphonePermission": "\u5141\u8bb8 VoceSpace \u5728\u4f60\u5f00\u542f\u9ea6\u514b\u98ce\u65f6\u4f20\u8f93\u58f0\u97f3\u3002"
        }
      ],
      [
        "./plugins/withScreenSharing.cjs",
        {
          "appGroupIdentifier": "group.com.privoce.vocechatclient"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}
