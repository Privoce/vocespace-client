# Copy to deploy/compose.env; use --env-file explicitly. Do not commit real secrets.
PUBLIC_ORIGIN=https://space.example.com
WEB_BIND=127.0.0.1
WEB_PORT=3000
API_BIND=127.0.0.1
API_PORT=3001
VOCESPACE_API_URL=http://api:3001
NEXT_PUBLIC_BASE_PATH=

# Existing independent LiveKit. This URL must also be reachable by clients.
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HOST_TOKEN=
PLATFORM_JWT_SECRET=
LICENSE_SECRET=

# Enable the local-redis profile or enter an external Redis host.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Requires Egress and private S3 configured in /data/vocespace.conf.json.
PREVIEW_ENABLED=false
PREVIEW_RENDERER_BASE_URL=https://api.example.com
PREVIEW_S3_ENDPOINT=
PREVIEW_MAX_SOURCES=3

# Use immutable release tags after publishing.
WEB_IMAGE=vocespace-web:local
API_IMAGE=vocespace-api:local

# Account auth uses the existing Supabase project; only injected into the API container.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ACCOUNT_PUBLIC_URL=https://space.example.com

# Umami: build-time opt-in; rebuild Web after changing these public values.
NEXT_PUBLIC_UMAMI_ENABLED=false
NEXT_PUBLIC_UMAMI_URL=https://rds.vocespace.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=d2fe7209-e79d-45cc-8c0d-20b5f6035ce7
