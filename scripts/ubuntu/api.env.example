# API only. Edit before activation; never put these secrets in Web/mobile variables.
PUBLIC_ORIGIN=https://vocespace.com
ACCOUNT_PUBLIC_URL=https://vocespace.com
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_JWT_SECRET=
LICENSE_SECRET=
PREVIEW_ENABLED=false
PREVIEW_RENDERER_BASE_URL=https://vocespace.com
PREVIEW_MAX_SOURCES=3

# Existing installation: copy vocespace.conf.json and data into api-data.
# Fresh installation ONLY: uncomment and fill all required values below.
# VOCESPACE_INIT_CONFIG=true
# LIVEKIT_URL=wss://vocespace.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# HOST_TOKEN=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
