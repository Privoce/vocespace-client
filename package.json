{
  "name": "vocespace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:api && pnpm build:web",
    "start": "pnpm start:web",
    "lint": "pnpm --filter @vocespace/web lint",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "build:api": "pnpm --filter @vocespace/api build",
    "start:api": "pnpm --filter @vocespace/api start",
    "dev:api": "pnpm --filter @vocespace/api dev",
    "test:backend": "pnpm build:api && node tests/integration/backend.mjs",
    "dev:web": "pnpm --filter @vocespace/web dev",
    "start:web": "pnpm --filter @vocespace/web start",
    "build:web": "pnpm --filter @vocespace/web build",
    "dev:mobile": "pnpm --filter @vocespace/mobile dev",
    "typecheck:mobile": "pnpm --filter @vocespace/mobile typecheck",
    "package:api": "pnpm --filter @vocespace/api --config.inject-workspace-packages=true deploy --prod",
    "typecheck:ui": "pnpm --filter @vocespace/ui typecheck",
    "typecheck:api": "pnpm --filter @vocespace/api typecheck",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:deployment-scripts": "node --test scripts/ubuntu/deploy.test.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.7",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "jsdom": "26.1.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4",
    "@ant-design/icons": "5.x",
    "antd": "^6.6.5",
    "dayjs": "^1.11.13",
    "fast-deep-equal": "^3.1.3",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-client": "2.9.3",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native-web": "0.21.4",
    "socket.io-client": "^4.8.1",
    "@vocespace/i18n": "workspace:*",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@vocespace/config-node": "workspace:*",
    "dotenv": "^16.5.0"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "@livekit/components-react@2.8.1>usehooks-ts": "3.1.1"
    },
    "patchedDependencies": {
      "@ant-design/react-native@5.4.3": "patches/@ant-design__react-native@5.4.3.patch"
    }
  }
}
