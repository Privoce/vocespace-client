{
  "name": "vocespace",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:api && pnpm build:web",
    "start": "pnpm start:web",
    "lint": "pnpm --filter @vocespace/web lint",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "build:api": "pnpm --filter @vocespace/api build",
    "start:api": "pnpm --filter @vocespace/api start",
    "dev:api": "pnpm --filter @vocespace/api dev",
    "test:backend": "pnpm build:api && node tests/integration/backend.mjs",
    "dev:web": "pnpm --filter @vocespace/web dev",
    "start:web": "pnpm --filter @vocespace/web start",
    "build:web": "pnpm --filter @vocespace/web build",
    "dev:mobile": "pnpm --filter @vocespace/mobile dev",
    "typecheck:mobile": "pnpm --filter @vocespace/mobile typecheck",
    "package:api": "pnpm --filter @vocespace/api --config.inject-workspace-packages=true deploy --prod"
  },
  "dependencies": {
    "@ant-design/icons": "5.x",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@datadog/browser-logs": "^5.23.3",
    "@hyperbeam/web": "^0.0.38",
    "@iarna/toml": "^2.2.5",
    "@livekit/components-core": "^0.12.13",
    "@livekit/components-react": "2.8.1",
    "@livekit/components-styles": "1.1.4",
    "@livekit/krisp-noise-filter": "0.2.16",
    "@mediapipe/camera_utils": "0.3.1675466862",
    "@mediapipe/holistic": "0.5.1675471629",
    "antd": "^6.6.5",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "detect-gpu": "^5.0.70",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "fast-deep-equal": "^3.1.3",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "link-preview-js": "^3.0.14",
    "live2d-motionsync": "^0.0.4",
    "livekit-client": "2.9.3",
    "livekit-server-sdk": "2.10.1",
    "next": "14.2.35",
    "nodemailer": "^9.0.1",
    "openai": "^6.7.0",
    "p5": "^1.11.13",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "6.5.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-notion-x": "^7.4.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^18.1.0",
    "tinykeys": "^3.0.0",
    "ulid": "^3.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/p5": "^1.7.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.23",
    "jsdom": "26.1.0",
    "sass": "^1.85.1",
    "source-map-loader": "^5.0.0",
    "typescript": "5.7.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.27.0"
}
