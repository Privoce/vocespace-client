# Copy to .env.local or inject environment variables in the deployment.
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
# Existing absolute data directory; omit in the workspace to preserve root data.
# VOCESPACE_DATA_DIR=/srv/vocespace-data
# Required only for the existing signed platform login integration (32+ characters).
# PLATFORM_JWT_SECRET=
WORKER_ENABLED=true

# Optional Native observer pilot: an existing guest-enabled main-room-only test Space.
# Off by default. While enabled this Space cannot create/edit subrooms, even via Web.
# NATIVE_CONFERENCE_SPACE=mobile-test
