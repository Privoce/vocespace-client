# Copy to .env.local or inject environment variables in the deployment.
API_HOST=127.0.0.1
API_PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
# Existing absolute data directory; omit in the workspace to preserve root data.
# VOCESPACE_DATA_DIR=/srv/vocespace-data
# Required only for the existing signed platform login integration (32+ characters).
# PLATFORM_JWT_SECRET=
WORKER_ENABLED=true

# Native discovers existing guest-accessible VoceSpace Spaces without an env allowlist.
# NATIVE_CONFERENCE_SPACE / NATIVE_CONFERENCE_SPACES are obsolete and ignored.
# Private child rooms remain inaccessible to Native guests; previews are not enabled.

# Main Space HLS previews: users in every child Room are excluded.
# Requires Egress Web capture and private S3 configured in vocespace.conf.json.
PREVIEW_ENABLED=false
# API base URL reachable from inside the Egress container (not the phone's localhost).
# Include the deployment path prefix if applicable. Example: https://api.example.com/
PREVIEW_RENDERER_BASE_URL=
# Optional S3-compatible endpoint, reachable from both API and Egress.
PREVIEW_S3_ENDPOINT=
# Max concurrent Space composites, not max viewers. Idle sources stop after ~45–60 seconds.
PREVIEW_MAX_SOURCES=3

# Opt-in first installation. Existing vocespace.conf.json always wins.
# VOCESPACE_INIT_CONFIG=true
# LIVEKIT_URL=wss://rtc.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# HOST_TOKEN=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
