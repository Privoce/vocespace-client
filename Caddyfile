home.vocespace.com {
    handle {
        reverse_proxy localhost:3099
    }
}
vocespace.com {
    handle_path /local_deploy/* {
        root * /var/www/scripts
        file_server browse
    }

    redir /incubator https://space.gpg.eco/incubator

    # 旧 3060 服务保持原路径和跨域策略；不覆盖新版应用的响应。
    @legacyApi path /api/s3/* /api/rooms/*
    handle @legacyApi {
        header {
            Access-Control-Allow-Origin *
            Access-Control-Allow-Methods "GET, POST, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization"
        }
        route {
            @legacyPreflight method OPTIONS
            respond @legacyPreflight 204
            reverse_proxy localhost:3060 {
                header_up Host {host}
                header_up Upgrade {http.request.header.Upgrade}
                header_up Connection {http.request.header.Connection}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}
            }
        }
    }

    # License 已迁移，根路径及所有子路由统一走 Web 3000 → API 3001。
    @licenseApi path /api/license /api/license/*
    handle @licenseApi {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # LiveKit 信令 / Egress RPC 保留 7880。
    handle /twirp/* {
        reverse_proxy localhost:7880 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /rtc* {
        reverse_proxy localhost:7880 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Web 转发 Socket.IO 到 API；Caddy 原生支持 WebSocket Upgrade。
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Real-IP {remote_host}
        }
    }

    # Legal pages: /var/vocespace/vocespace_com/{privacy,terms}/index.html
    @privacy path /privacy /privacy/ /privacy.html
    handle @privacy {
        root * /var/vocespace/vocespace_com
        rewrite * /privacy/index.html
        file_server
    }

    @terms path /terms /terms/ /terms.html
    handle @terms {
        root * /var/vocespace/vocespace_com
        rewrite * /terms/index.html
        file_server
    }

    handle / {
        root * /var/vocespace/vocespace_com
        file_server
        try_files {path} /index.html
    }

    # 页面、/deleteAccount、/legal/* 由 Web 处理；API/上传经 Web 转发。
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Real-IP {remote_host}
        }
    }
}

