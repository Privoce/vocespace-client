sohive.voce.chat {
    handle_path /widget/* {
        root * /var/vocespace/sohive
        file_server

        # 正确写法：给所有 JS 加禁用缓存头
        header *.js Cache-Control "no-store, no-cache, must-revalidate"
        header *.js Pragma "no-cache"
        header *.js Expires "0"
    }
}



